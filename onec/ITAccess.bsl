// Расширение: ВыгрузкаПрав_ИТ
// HTTP-сервис: ITAccess, корневой URL: itaccess
// Шаблоны:
//   /snapshot  GET -> SnapshotGET
//   /log       GET -> LogGET
// Требования:
//   - у расширения снят флажок "Безопасный режим" (нужен привилегированный режим);
//   - в публикации включена публикация HTTP-сервисов расширений;
//   - технический пользователь svc_itaccess (стандартная аутентификация).
// Деплой вручную через конфигуратор. Этот файл - справочная копия.

#Область ОбработчикиHTTP

Функция SnapshotGET(Запрос)
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ИзвестныеИБ = Новый Соответствие;
		Данные = Новый Структура;
		Данные.Вставить("base", СтрокаСоединенияИнформационнойБазы());
		Данные.Вставить("generated_at", ТекущаяДатаСеанса());
		Данные.Вставить("users", ВыгрузитьПользователей(ИзвестныеИБ));
		Данные.Вставить("ib_orphans", ВыгрузитьСиротИБ(ИзвестныеИБ));
		Данные.Вставить("profiles", ВыгрузитьПрофили());
		Данные.Вставить("user_rights", ВыгрузитьПраваПользователей());
		Возврат ОтветJSON(Данные);
	Исключение
		Возврат ОтветJSON(Новый Структура("error", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())), 500);
	КонецПопытки;
КонецФункции

Функция LogGET(Запрос)
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ПараметрС = Запрос.ПараметрыЗапроса.Получить("from");
		ДатаС = ?(ЗначениеЗаполнено(ПараметрС), ПрочитатьДатуJSON(ПараметрС, ФорматДатыJSON.ISO), ТекущаяДатаСеанса() - 86400);
		
		События = Новый Массив;
		
		// Изменения пользователей ИБ
		Отбор = Новый Структура;
		Отбор.Вставить("ДатаНачала", ДатаС);
		Отбор.Вставить("Событие", СтрРазделить("_$User$_.New,_$User$_.Update,_$User$_.Delete", ","));
		ДобавитьСобытия(События, Отбор);
		
		// Изменения справочников прав
		Мета = Новый Массив;
		Мета.Добавить(Метаданные.Справочники.Пользователи);
		Мета.Добавить(Метаданные.Справочники.ГруппыПользователей);
		Мета.Добавить(Метаданные.Справочники.ГруппыДоступа);
		Мета.Добавить(Метаданные.Справочники.ПрофилиГруппДоступа);
		Отбор = Новый Структура;
		Отбор.Вставить("ДатаНачала", ДатаС);
		Отбор.Вставить("Событие", СтрРазделить("_$Data$_.New,_$Data$_.Update,_$Data$_.Delete", ","));
		Отбор.Вставить("Метаданные", Мета);
		ДобавитьСобытия(События, Отбор);
		
		Возврат ОтветJSON(Новый Структура("base, from, events", СтрокаСоединенияИнформационнойБазы(), ДатаС, События));
	Исключение
		Возврат ОтветJSON(Новый Структура("error", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())), 500);
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область Выгрузка

Функция ВыгрузитьПользователей(ИзвестныеИБ)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	П.Ссылка КАК Ссылка,
	|	П.Наименование КАК Наименование,
	|	П.ИдентификаторПользователяИБ КАК ИдИБ,
	|	П.Недействителен КАК Недействителен,
	|	П.Служебный КАК Служебный,
	|	П.ПометкаУдаления КАК ПометкаУдаления,
	|	П.ФизическоеЛицо КАК ФизЛицо,
	|	ПРЕДСТАВЛЕНИЕ(П.ФизическоеЛицо) КАК ФизЛицоПредставление,
	|	П.Подразделение КАК Подразделение,
	|	ПРЕДСТАВЛЕНИЕ(П.Подразделение) КАК ПодразделениеПредставление
	|ИЗ
	|	Справочник.Пользователи КАК П");
	
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр = Новый Структура;
		Стр.Вставить("id", Ид(Выборка.Ссылка));
		Стр.Вставить("name", Выборка.Наименование);
		Стр.Вставить("invalid", Выборка.Недействителен);
		Стр.Вставить("service", Выборка.Служебный);
		Стр.Вставить("deleted", Выборка.ПометкаУдаления);
		Стр.Вставить("person_id", Ид(Выборка.ФизЛицо));
		Стр.Вставить("person_name", Выборка.ФизЛицоПредставление);
		Стр.Вставить("department_id", Ид(Выборка.Подразделение));
		Стр.Вставить("department_name", Выборка.ПодразделениеПредставление);
		
		ПИБ = Неопределено;
		Если ЗначениеЗаполнено(Выборка.ИдИБ) Тогда
			ПИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Выборка.ИдИБ);
			ИзвестныеИБ.Вставить(Строка(Выборка.ИдИБ), Истина);
		КонецЕсли;
		Стр.Вставить("ib", ОписаниеПользователяИБ(ПИБ));
		
		Результат.Добавить(Стр);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ОписаниеПользователяИБ(ПИБ)
	Если ПИБ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Стр = Новый Структура;
	Стр.Вставить("ib_id", Строка(ПИБ.УникальныйИдентификатор));
	Стр.Вставить("login", ПИБ.Имя);
	Стр.Вставить("full_name", ПИБ.ПолноеИмя);
	Стр.Вставить("auth_standard", ПИБ.АутентификацияСтандартная);
	Стр.Вставить("auth_os", ПИБ.АутентификацияОС);
	Стр.Вставить("auth_openid", ПИБ.АутентификацияOpenID);
	Стр.Вставить("os_user", ПИБ.ПользовательОС);
	Части = СтрРазделить(ПИБ.ПользовательОС, "\", Ложь); // "\\DOMAIN\login"
	Стр.Вставить("ad_domain", ?(Части.Количество() = 2, НРег(Части[0]), Неопределено));
	Стр.Вставить("ad_login", ?(Части.Количество() = 2, НРег(Части[1]), Неопределено));
	Стр.Вставить("login_allowed", ПИБ.АутентификацияСтандартная Или ПИБ.АутентификацияОС Или ПИБ.АутентификацияOpenID);
	Роли = Новый Массив;
	Для Каждого Роль Из ПИБ.Роли Цикл
		Роли.Добавить(Роль.Имя);
	КонецЦикла;
	Стр.Вставить("roles", Роли);
	Возврат Стр;
КонецФункции

Функция ВыгрузитьСиротИБ(ИзвестныеИБ)
	Результат = Новый Массив;
	Для Каждого ПИБ Из ПользователиИнформационнойБазы.ПолучитьПользователей() Цикл
		Если ИзвестныеИБ[Строка(ПИБ.УникальныйИдентификатор)] = Неопределено Тогда
			Результат.Добавить(ОписаниеПользователяИБ(ПИБ));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ВыгрузитьПрофили()
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Пр.Ссылка КАК Ссылка,
	|	Пр.Наименование КАК Наименование,
	|	Пр.ПометкаУдаления КАК ПометкаУдаления,
	|	Пр.ИдентификаторПоставляемыхДанных КАК ИдПоставляемых
	|ИЗ
	|	Справочник.ПрофилиГруппДоступа КАК Пр
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Р.Ссылка КАК Профиль,
	|	Р.Роль.Имя КАК ИмяРоли,
	|	Р.Роль.Синоним КАК СинонимРоли
	|ИЗ
	|	Справочник.ПрофилиГруппДоступа.Роли КАК Р");
	Пакет = Запрос.ВыполнитьПакет();
	
	РолиПоПрофилю = Новый Соответствие;
	Выборка = Пакет[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьВСоответствие(РолиПоПрофилю, Выборка.Профиль,
			Новый Структура("name, title", Выборка.ИмяРоли, Выборка.СинонимРоли));
	КонецЦикла;
	
	Результат = Новый Массив;
	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Стр = Новый Структура;
		Стр.Вставить("id", Ид(Выборка.Ссылка));
		Стр.Вставить("name", Выборка.Наименование);
		Стр.Вставить("deleted", Выборка.ПометкаУдаления);
		Стр.Вставить("supplied", ЗначениеЗаполнено(Выборка.ИдПоставляемых));
		Роли = РолиПоПрофилю[Выборка.Ссылка];
		Стр.Вставить("roles", ?(Роли = Неопределено, Новый Массив, Роли));
		Результат.Добавить(Стр);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ВыгрузитьПраваПользователей()
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Составы.Пользователь КАК Пользователь,
	|	Составы.Пользователь.Наименование КАК ПользовательПредставление,
	|	ГДП.Ссылка КАК ГруппаДоступа,
	|	ГДП.Ссылка.Наименование КАК ГруппаНаименование,
	|	ГДП.Ссылка.Профиль КАК Профиль,
	|	ГДП.Ссылка.Профиль.Наименование КАК ПрофильНаименование,
	|	ГДП.Пользователь КАК Через,
	|	ПРЕДСТАВЛЕНИЕ(ГДП.Пользователь) КАК ЧерезПредставление
	|ИЗ
	|	Справочник.ГруппыДоступа.Пользователи КАК ГДП
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоставыГруппПользователей КАК Составы
	|		ПО ГДП.Пользователь = Составы.ГруппаПользователей
	|ГДЕ
	|	НЕ ГДП.Ссылка.ПометкаУдаления
	|	И НЕ ГДП.Ссылка.Профиль.ПометкаУдаления
	|	И Составы.Используется
	|	И Составы.Пользователь ССЫЛКА Справочник.Пользователи
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПользовательПредставление,
	|	ПрофильНаименование
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПВД.Ссылка КАК Владелец,
	|	ПВД.ВидДоступа КАК ВидДоступа,
	|	ПВД.Предустановленный КАК Предустановленный,
	|	ПВД.ВсеРазрешены КАК ВсеРазрешены
	|ИЗ
	|	Справочник.ПрофилиГруппДоступа.ВидыДоступа КАК ПВД
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПЗД.Ссылка КАК Владелец,
	|	ПЗД.ВидДоступа КАК ВидДоступа,
	|	ПЗД.ЗначениеДоступа КАК ЗначениеДоступа,
	|	ПРЕДСТАВЛЕНИЕ(ПЗД.ЗначениеДоступа) КАК Представление
	|ИЗ
	|	Справочник.ПрофилиГруппДоступа.ЗначенияДоступа КАК ПЗД
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГВД.Ссылка КАК Владелец,
	|	ГВД.ВидДоступа КАК ВидДоступа,
	|	ЛОЖЬ КАК Предустановленный,
	|	ГВД.ВсеРазрешены КАК ВсеРазрешены
	|ИЗ
	|	Справочник.ГруппыДоступа.ВидыДоступа КАК ГВД
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГЗД.Ссылка КАК Владелец,
	|	ГЗД.ВидДоступа КАК ВидДоступа,
	|	ГЗД.ЗначениеДоступа КАК ЗначениеДоступа,
	|	ПРЕДСТАВЛЕНИЕ(ГЗД.ЗначениеДоступа) КАК Представление
	|ИЗ
	|	Справочник.ГруппыДоступа.ЗначенияДоступа КАК ГЗД");
	Пакет = Запрос.ВыполнитьПакет();
	
	НастройкиПрофилей = НастройкиВидов(Пакет[1], Пакет[2]);
	НастройкиГрупп = НастройкиВидов(Пакет[3], Пакет[4]);
	КэшОграничений = Новый Соответствие;
	
	ПоПользователям = Новый Соответствие;
	Результат = Новый Массив;
	
	Выборка = Пакет[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = ПоПользователям[Выборка.Пользователь];
		Если Запись = Неопределено Тогда
			Запись = Новый Структура;
			Запись.Вставить("user_id", Ид(Выборка.Пользователь));
			Запись.Вставить("user_name", Выборка.ПользовательПредставление);
			Запись.Вставить("profiles", Новый Массив);
			Запись.Вставить("organizations", Новый Структура("all, list", Ложь, Новый Массив));
			ПоПользователям.Вставить(Выборка.Пользователь, Запись);
			Результат.Добавить(Запись);
		КонецЕсли;
		
		Ограничения = КэшОграничений[Выборка.ГруппаДоступа];
		Если Ограничения = Неопределено Тогда
			Ограничения = ОграниченияГруппы(Выборка.ГруппаДоступа, Выборка.Профиль, НастройкиПрофилей, НастройкиГрупп);
			КэшОграничений.Вставить(Выборка.ГруппаДоступа, Ограничения);
		КонецЕсли;
		
		Профиль = Новый Структура;
		Профиль.Вставить("profile_id", Ид(Выборка.Профиль));
		Профиль.Вставить("profile_name", Выборка.ПрофильНаименование);
		Профиль.Вставить("access_group_id", Ид(Выборка.ГруппаДоступа));
		Профиль.Вставить("access_group_name", Выборка.ГруппаНаименование);
		Профиль.Вставить("direct", ТипЗнч(Выборка.Через) = Тип("СправочникСсылка.Пользователи"));
		Профиль.Вставить("via_name", Выборка.ЧерезПредставление);
		Профиль.Вставить("restrictions", Ограничения);
		Запись.profiles.Добавить(Профиль);
		
		ДополнитьСводкуОрганизаций(Запись.organizations, Ограничения);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Владелец (профиль или группа доступа) -> Соответствие(ИмяВида -> Структура)
Функция НастройкиВидов(РезультатВидов, РезультатЗначений)
	Настройки = Новый Соответствие;
	
	Выборка = РезультатВидов.Выбрать();
	Пока Выборка.Следующий() Цикл
		ПоВладельцу = Настройки[Выборка.Владелец];
		Если ПоВладельцу = Неопределено Тогда
			ПоВладельцу = Новый Соответствие;
			Настройки.Вставить(Выборка.Владелец, ПоВладельцу);
		КонецЕсли;
		ПоВладельцу.Вставить(ИмяВидаДоступа(Выборка.ВидДоступа), Новый Структура("Предустановленный, ВсеРазрешены, Значения",
			Выборка.Предустановленный, Выборка.ВсеРазрешены, Новый Массив));
	КонецЦикла;
	
	Выборка = РезультатЗначений.Выбрать();
	Пока Выборка.Следующий() Цикл
		ПоВладельцу = Настройки[Выборка.Владелец];
		Если ПоВладельцу = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Вид = ПоВладельцу[ИмяВидаДоступа(Выборка.ВидДоступа)];
		Если Вид = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Вид.Значения.Добавить(Новый Структура("id, name", Ид(Выборка.ЗначениеДоступа), Выборка.Представление));
	КонецЦикла;
	
	Возврат Настройки;
КонецФункции

// Итоговые ограничения по всем видам доступа, используемым профилем группы
Функция ОграниченияГруппы(Группа, Профиль, НастройкиПрофилей, НастройкиГрупп)
	Результат = Новый Массив;
	ВидыПрофиля = НастройкиПрофилей[Профиль];
	Если ВидыПрофиля = Неопределено Тогда
		Возврат Результат; // профиль без видов доступа - ограничений нет
	КонецЕсли;
	ВидыГруппы = НастройкиГрупп[Группа];
	
	Для Каждого КлючИЗначение Из ВидыПрофиля Цикл
		Если КлючИЗначение.Значение.Предустановленный Тогда
			Источник = КлючИЗначение.Значение;
			ИмяИсточника = "profile";
		Иначе
			Источник = ?(ВидыГруппы = Неопределено, Неопределено, ВидыГруппы[КлючИЗначение.Ключ]);
			ИмяИсточника = "access_group";
		КонецЕсли;
		
		Огр = Новый Структура("kind, source, mode, values", КлючИЗначение.Ключ, ИмяИсточника);
		Если Источник = Неопределено Тогда
			Огр.mode = "not_configured";
			Огр.values = Новый Массив;
		ИначеЕсли Источник.ВсеРазрешены Тогда
			Огр.mode = ?(Источник.Значения.Количество() = 0, "all", "all_except");
			Огр.values = Источник.Значения;
		Иначе
			Огр.mode = "only";
			Огр.values = Источник.Значения;
		КонецЕсли;
		Результат.Добавить(Огр);
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Процедура ДополнитьСводкуОрганизаций(Сводка, Ограничения)
	ОгрОрганизаций = Неопределено;
	Для Каждого Огр Из Ограничения Цикл
		Если Огр.kind = "Организации" Тогда
			ОгрОрганизаций = Огр;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ОгрОрганизаций = Неопределено
		Или ОгрОрганизаций.mode = "all"
		Или ОгрОрганизаций.mode = "all_except" Тогда
		Сводка.all = Истина;
	ИначеЕсли ОгрОрганизаций.mode = "only" Тогда
		Для Каждого Значение Из ОгрОрганизаций.values Цикл
			Если Сводка.list.Найти(Значение.name) = Неопределено Тогда
				Сводка.list.Добавить(Значение.name);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Служебные

Процедура ДобавитьСобытия(Результат, Отбор)
	Таблица = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Таблица, Отбор, "Дата,ИмяПользователя,Событие,Метаданные,ПредставлениеДанных,Комментарий,Компьютер");
	Для Каждого Стр Из Таблица Цикл
		Результат.Добавить(Новый Структура("date, who, event, object_type, object, comment, host",
			Стр.Дата, Стр.ИмяПользователя, Стр.Событие, Строка(Стр.Метаданные),
			Стр.ПредставлениеДанных, Стр.Комментарий, Стр.Компьютер));
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьВСоответствие(Соответствие, Ключ, Значение)
	Массив = Соответствие[Ключ];
	Если Массив = Неопределено Тогда
		Массив = Новый Массив;
		Соответствие.Вставить(Ключ, Массив);
	КонецЕсли;
	Массив.Добавить(Значение);
КонецПроцедуры

Функция ИмяВидаДоступа(ВидДоступа)
	МетаОбъект = Метаданные.НайтиПоТипу(ТипЗнч(ВидДоступа));
	Возврат ?(МетаОбъект = Неопределено, Строка(ТипЗнч(ВидДоступа)), МетаОбъект.Имя);
КонецФункции

Функция Ид(Ссылка)
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Строка(Ссылка.УникальныйИдентификатор());
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ОтветJSON(Данные, КодСостояния = 200)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	Настройки = Новый НастройкиСериализацииJSON;
	Настройки.ФорматСериализацииДаты = ФорматДатыJSON.ISO;
	Настройки.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДатаСоСмещением;
	ЗаписатьJSON(Запись, Данные, Настройки);
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

#КонецОбласти
