 "charts": [],
 "content": "[{\"id\": \"ar00000001\", \"type\": \"paragraph\", \"data\": {\"text\": \"<b>Слои реестра.</b> 1) Кадры из баз ЗУП — источник правды о сотрудниках, подразделениях и организациях. 2) Active Directory — учётки и группы, привязаны к сотрудникам (employeeNumber или ФИО). 3) Пользователи 1С (ЗУП, Бухгалтерия и другие базы) — привязаны к сотрудникам и к учёткам AD. 4) Bitrix24. 5) Свои процессы и роли. <br><b>Подключить базу:</b> «Базы 1С» → новая база, код (например BP1), конфигурация, URL сервисов и пароли → «Загрузить». Кадры грузятся только из баз ЗУП. <b>Подключить домен:</b> «Домены AD» → сервер LDAP, Base DN, учётка только на чтение → «Проверить подключение» → «Загрузить».\", \"col\": 12}}, {\"id\": \"ar00000002\", \"type\": \"spacer\", \"data\": {\"col\": 12}}, {\"id\": \"ar00000003\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Кадры — источник правды (базы ЗУП)</b></span>\", \"col\": 12}}, {\"id\": \"ar00000004\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Сотрудники\", \"col\": 4}}, {\"id\": \"ar00000005\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Трудоустройства\", \"col\": 4}}, {\"id\": \"ar00000006\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Дерево подразделений\", \"col\": 4}}, {\"id\": \"ar00000007\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Длительное отсутствие\", \"col\": 4}}, {\"id\": \"ar00000008\", \"type\": \"spacer\", \"data\": {\"col\": 12}}, {\"id\": \"ar00000009\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Разбор кадров</b></span>\", \"col\": 12}}, {\"id\": \"ar00000010\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Кандидаты на склейку\", \"col\": 4}}, {\"id\": \"ar00000011\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Новые кадровые события\", \"col\": 4}}, {\"id\": \"ar00000012\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Только совместительство\", \"col\": 4}}, {\"id\": \"ar00000013\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Расхождения руководителей\", \"col\": 4}}, {\"id\": \"ar00000014\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Кандидаты в руководители\", \"col\": 4}}, {\"id\": \"ar00000015\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Нет в выгрузке\", \"col\": 4}}, {\"id\": \"ar00000016\", \"type\": \"spacer\", \"data\": {\"col\": 12}}, {\"id\": \"ar00000017\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Пользователи 1С и права (все базы)</b></span>\", \"col\": 12}}, {\"id\": \"ar00000018\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Обзор доступа\", \"col\": 4}}, {\"id\": \"ar00000019\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Полный отчёт по доступам\", \"col\": 4}}, {\"id\": \"ar00000020\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Пользователи 1С\", \"col\": 4}}, {\"id\": \"ar00000021\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Не привязаны к сотруднику\", \"col\": 4}}, {\"id\": \"ar00000022\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Вход у неработающих\", \"col\": 4}}, {\"id\": \"ar00000023\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Роли в обход профилей\", \"col\": 4}}, {\"id\": \"ar00000024\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Сироты ИБ\", \"col\": 4}}, {\"id\": \"ar00000025\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Доступ ко всем организациям\", \"col\": 4}}, {\"id\": \"ar00000026\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Профили доступа\", \"col\": 4}}, {\"id\": \"ar00000027\", \"type\": \"shortcut\", \"data\": {\"shortcut_name\": \"Журнал изменений прав\", \"col\": 4}}, {\"id\": \"ar00000028\", \"type\": \"spacer\", \"data\": {\"col\": 12}}, {\"id\": \"ar00000029\", \"type\": \"header\", \"data\": {\"text\": \"<span class=\\\"h4\\\"><b>Active Directory</b></span>\", \"col\": 12}}, {\"id\": \"ar00000030\", \"typ