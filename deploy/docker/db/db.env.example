DB_ROOT_PASSWORD=change-me-long-random
# address of this server's interface in the network of the application server, e.g. 10.0.0.5.
# Not 0.0.0.0: the database would answer on every interface. Also allow 3306 only from the
# application server in the firewall.
DB_BIND_ADDRESS=
# 3306; use another port (3307) if MySQL already occupies 3306 on this server
DB_PUBLISH_PORT=3306
# about half of the RAM of the database server
INNODB_BUFFER_POOL_SIZE=2G
