# Access Registry in Docker (frappe_docker). Copy to registry.env and fill in.
# All variables: https://github.com/frappe/frappe_docker/blob/main/docs/02-setup/04-env-variables.md

# ---- image built by build.sh
CUSTOM_IMAGE=access-registry
# Which ./compose.sh mode update.sh uses: http | own-cert | letsencrypt
COMPOSE_MODE=http
CUSTOM_TAG=2026-10-01
PULL_POLICY=never
# not used by the registry image, but compose.yaml of frappe_docker expects it
ERPNEXT_VERSION=v15

# ---- external MariaDB on the database server (see db/compose.yaml)
DB_HOST=db.company.local
DB_PORT=3306

# ---- web
# site name = the host name people open, e.g. registry.company.local
FRAPPE_SITE_NAME_HEADER=registry.company.local
GUNICORN_WORKERS=5
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
PROXY_READ_TIMEOUT=300s
# collector uploads from Synology can be several MB
CLIENT_MAX_BODY_SIZE=100m

# ---- mode «http»: the stack publishes plain HTTP on this port (behind a company reverse proxy)
HTTP_PUBLISH_PORT=8080

# ---- mode «own-cert»: HTTPS with a company certificate (files in tls/)
HTTPS_PUBLISH_PORT=443
TLS_CERT_FILE=./tls/registry.crt
TLS_KEY_FILE=./tls/registry.key

# ---- mode «letsencrypt»: public DNS name and ports 80/443 open to the internet
LETSENCRYPT_EMAIL=admin@company.ru
SITES_RULE=Host(`registry.company.ru`)

# ---- backups inside the stack (bench backup to the sites volume); copy them off the server!
BACKUP_CRONSTRING=@every 6h
